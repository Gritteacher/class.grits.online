{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kruthai-social-classroom",
  "main": "worker/index.js",
  "account_id": "36723824247462632e940a959a4b77d8",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/.netlify/functions/*"
    ]
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "0 19 * * *"
    ]
  },
  "routes": [
    {
      "pattern": "class.gritspace.cc",
      "custom_domain": true
    }
  ]
}
